{
  "name": "slack-foosball",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "cdk": "cdk",
    "deploy": "tsx scripts/deploy.ts",
    "destroy": "tsx scripts/destroy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1176.0",
    "@aws-sdk/lib-dynamodb": "^3.1176.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1149.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
